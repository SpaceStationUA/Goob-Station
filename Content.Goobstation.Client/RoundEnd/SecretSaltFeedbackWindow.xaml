<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
    Title="Секрет Сіль 1.4 — відгук"
    MinSize="510 510" SetSize="540 570">
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
            <Label Text="Оцініть раунд «Секрет Сіль 1.4»" StyleClasses="LabelHeading" />
            <Label Text="Необов'язково. Можна просто пропустити." />
            <Label Text="Ваша оцінка (1–5):" />
            <BoxContainer Name="RatingButtons" Orientation="Horizontal" SeparationOverride="6" />
            <Label Text="Що варто покращити? (можна вибрати кілька)" />
            <CheckBox Name="FewAntags" Text="Замало антагоністів" />
            <CheckBox Name="ManyAntags" Text="Забагато антагоністів" />
            <CheckBox Name="FewEvents" Text="Замало подій" />
            <CheckBox Name="TooChaotic" Text="Надмірний хаос" />
            <CheckBox Name="Other" Text="Інше" />
            <Label Text="Коментар (необов'язково, до 500 символів):" />
            <TextEdit Name="CommentInput" MinHeight="100" HorizontalExpand="True" />
            <Label Text="Ваш нікнейм, оцінка та коментар будуть передані автору режиму Секрет Сіль для аналізу відгуків і покращення балансу." />
            <Label Name="StatusLabel" Text="Оберіть оцінку або пропустіть." />
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Button Name="SendButton" Text="Надіслати відгук" Disabled="True" HorizontalExpand="True"/>
                <Button Name="SkipButton" Text="Пропустити" />
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
