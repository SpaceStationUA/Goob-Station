<Control xmlns="https://spacestation14.io" MinWidth="300" MaxWidth="800"> <!-- Pirate - map vote previews -->
    <PanelContainer StyleClasses="BackgroundPanel" />
    <BoxContainer Margin="8" Orientation="Vertical"> <!-- Pirate - map vote previews -->
        <Label Name="VoteCaller" />
        <RichTextLabel Name="VoteTitle" />
        <Button Margin="4 4" Name="FollowVoteTarget" Text="{Loc 'ui-vote-follow-button-popup'}" Visible="False"></Button>

        <GridContainer Columns="3" Name="VoteOptionsContainer"/>
        <ProgressBar Margin="0 4" HorizontalExpand="True" Name="TimeLeftBar" MinValue="0" MaxValue="1"> <!-- Pirate - map vote previews -->
            <Label HorizontalAlignment="Center" Name="TimeLeftText" />
        </ProgressBar>
    </BoxContainer>
</Control>
