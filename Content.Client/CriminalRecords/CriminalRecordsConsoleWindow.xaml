<!-- Pirate: records photos (start) -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                       xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                       xmlns:records="clr-namespace:Content.Client._Pirate.StationRecords"
                       Title="{Loc 'criminal-records-console-window-title'}"
                       MinSize="930 600"
                       SetSize="930 600">
<!-- Pirate: records photos -->
<!-- Pirate: records photos (end) -->
    <BoxContainer Orientation="Vertical">
        <BoxContainer Name="AllList"
                      Orientation="Vertical"
                      VerticalExpand="True"
                      HorizontalExpand="True"
                      Margin="8">
            <!-- Record search bar -->
            <BoxContainer Margin="5 5 5 10"
                          HorizontalExpand="true"
                          VerticalAlignment="Center">
                <OptionButton Name="FilterType"
                              MinWidth="250"
                              Margin="0 0 10 0" />
                <!-- Populated in constructor -->
                <!-- Pirate: records photos (start) -->
                <LineEdit Name="FilterText"
                           PlaceHolder="{Loc 'criminal-records-filter-placeholder'}"
                           HorizontalExpand="True"
                           Margin="0 0 10 0" />
                <Button Name="DeleteRecordButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 4 0"
                        ToolTip="{Loc 'criminal-records-console-delete-record'}">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/Interface/VerbIcons/delete_transparent.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <Button Name="AddRecordButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 10 0"
                        ToolTip="{Loc 'criminal-records-console-add-record'}">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/Interface/VerbIcons/plus.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <!-- Pirate: records photos (end) -->
            </BoxContainer>
            <BoxContainer Orientation="Horizontal"
                          VerticalExpand="True">
                <!-- Record listing -->
                <!-- Pirate: record history -->
                <BoxContainer Orientation="Vertical"
                              Margin="5"
                              MinWidth="250"
                              MaxWidth="250">
                    <Label Name="NoRecords"
                           Text="{Loc 'criminal-records-console-no-records'}"
                           HorizontalExpand="True"
                           Align="Center"
                           FontColorOverride="DarkGray" />
                    <ScrollContainer VerticalExpand="True">
                        <ItemList Name="RecordListing" />
                        <!-- Populated when loading state -->
                    </ScrollContainer>
                    <!-- Pirate: record history (start) -->
                    <OptionButton Name="CrewListFilter"
                                  Margin="0 5 0 0" />
                    <!-- Pirate: record history (end) -->
                </BoxContainer>
                <Label Name="RecordUnselected"
                       Text="{Loc 'criminal-records-console-select-record-info'}"
                       HorizontalExpand="True"
                       Align="Center"
                       FontColorOverride="DarkGray" />
                <!-- Selected record info -->
                <BoxContainer Name="PersonContainer"
                        Orientation="Vertical"
                        VerticalExpand="True"
                        HorizontalExpand="True"
                        Margin="5"
                        Visible="False">
                    <!-- Pirate: record history (start) -->
                    <BoxContainer Orientation="Horizontal"
                                  Margin="0 0 0 4">
                        <Button Name="ProfileTabButton"
                                Text="{Loc 'records-console-tab-profile'}"
                                ToggleMode="True"
                                StyleClasses="OpenRight"
                                MinWidth="110" />
                        <Button Name="HistoryTabButton"
                                Text="{Loc 'records-console-tab-history'}"
                                ToggleMode="True"
                                StyleClasses="OpenLeft"
                                MinWidth="110" />
                    </BoxContainer>
                    <BoxContainer Name="ProfileView"
                                  Orientation="Vertical"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  Margin="5">
                    <!-- Pirate: record history (end) -->
                    <!-- Pirate: records photos (start) -->
                    <BoxContainer Orientation="Horizontal"
                                  Margin="0 0 0 5"
                                  HorizontalExpand="True"
                                  SeparationOverride="10">
                        <!-- Pirate: records photos -->
                        <records:RecordPortraitPanel Name="Portrait"
                                                     PhotoStyle="Security"
                                                     MinWidth="240"
                                                     MaxWidth="240" />
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SizeFlagsStretchRatio="1"
                                      SeparationOverride="6">
                            <Label Name="PersonName"
                                   StyleClasses="font-large" /> <!-- Pirate: ui fixes (legacy style migration; prefer upstream on conflict) -->
                            <BoxContainer Orientation="Horizontal"
                                          SeparationOverride="8">
                                <Label Text="{Loc 'crew-monitoring-ui-job-label'}"
                                       FontColorOverride="DarkGray" />
                                <TextureRect Name="PersonJobIcon"
                                             TextureScale="2 2"
                                             VerticalAlignment="Center" />
                                <Label Name="PersonJob" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}"
                                       FontColorOverride="DarkGray" />
                                <OptionButton Name="SpeciesButton"
                                              HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <!-- Pirate start: Citizenship -->
                                <Label Text="{Loc 'humanoid-profile-editor-citizenship-label'}"
                                       FontColorOverride="DarkGray" />
                                <OptionButton Name="CitizenshipButton"
                                              HorizontalExpand="True" />
                                <!-- Pirate end -->
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <Label Text="{Loc 'humanoid-profile-editor-employer-label'}"
                                       FontColorOverride="DarkGray" />
                                <OptionButton Name="EmployerButton"
                                               HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <Label Text="{Loc 'humanoid-profile-editor-age-label'}"
                                       FontColorOverride="DarkGray" />
                                <LineEdit Name="AgeEdit"
                                          HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <Label Text="{Loc 'humanoid-profile-editor-sex-label'}"
                                       FontColorOverride="DarkGray" />
                                <OptionButton Name="GenderButton"
                                              HorizontalExpand="True" />
                            </BoxContainer>
                            <!-- Pirate: records photos (start) -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="8">
                                <BoxContainer Orientation="Horizontal">
                                    <Label Name="StatusLabel"
                                           Text="{Loc 'criminal-records-console-status'}"
                                           FontColorOverride="DarkGray" />
                                    <Label Text=":"
                                           FontColorOverride="DarkGray" />
                                    <AnimatedTextureRect Name="PersonStatusTX"
                                                         Margin="8 0 0 0"
                                                         VerticalAlignment="Center" />
                                </BoxContainer>
                                <OptionButton Name="StatusOptionButton"
                                              HorizontalExpand="True" />
                            </BoxContainer>
                            <!-- Pirate: records photos (end) -->
                        </BoxContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal"
                                  Margin="0 0 0 5"
                                  SeparationOverride="8">
                        <Label Text="{Loc 'criminal-records-prints-filter'}"
                               FontColorOverride="DarkGray" />
                        <LineEdit Name="PersonPrintsEdit"
                                  HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal"
                                  Margin="0 0 0 5"
                                  SeparationOverride="8">
                        <Label Text="{Loc 'criminal-records-dna-filter'}"
                               FontColorOverride="DarkGray" />
                        <LineEdit Name="PersonDnaEdit"
                                  HorizontalExpand="True" />
                    </BoxContainer>
                    <!-- Pirate: records photos (end) -->
                    <PanelContainer StyleClasses="LowDivider"
                                    Margin="0 5 0 5" />
                    <!-- Pirate: records photos -->
                    <RichTextLabel Name="WantedReason"
                                   Visible="False"
                                   HorizontalExpand="True" />
                     <!-- Pirate: record history (start) -->
                    </BoxContainer>
                    <records:RecordHistoryPanel Name="HistoryView"
                                                Book="Security"
                                                Margin="5"
                                                Visible="False" />
                     <!-- Pirate: record history (end) -->
                </BoxContainer>
            </BoxContainer>
             <!-- Pirate: record history -->
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal"
                          Margin="10 2 5 0"
                          VerticalAlignment="Bottom">
                <Label Text="{Loc 'criminal-records-console-flavor-left'}"
                       StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'criminal-records-console-flavor-right'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             SetSize="19 19" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
