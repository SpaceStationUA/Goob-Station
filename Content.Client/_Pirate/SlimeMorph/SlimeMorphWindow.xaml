<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc 'slime-morph-window-title'}"
               MinSize="900 730">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1A1D24" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Horizontal" Margin="10" SeparationOverride="10">

            <!-- LEFT: free self-customization (50%) -->
            <PanelContainer HorizontalExpand="True" SizeFlagsStretchRatio="1" MinWidth="250">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#21242D" BorderColor="#2E323D" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical">

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#272B35" BorderColor="#6F9FE0" BorderThickness="0 0 0 2"
                                              ContentMarginLeftOverride="13" ContentMarginRightOverride="13"
                                              ContentMarginTopOverride="9" ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <Label Text="{Loc 'slime-morph-section-self'}" FontColorOverride="#6F9FE0" />
                    </PanelContainer>

                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" Margin="13 10">
                            <GridContainer Columns="2" Margin="0 0 0 6">
                                <Label Text="{Loc 'slime-morph-label-sex'}" FontColorOverride="#9AA1B0" />
                                <OptionButton Name="SexButton" HorizontalExpand="True" />
                                <Label Text="{Loc 'slime-morph-label-gender'}" FontColorOverride="#9AA1B0" />
                                <OptionButton Name="GenderButton" HorizontalExpand="True" />
                                <!-- Pirate: slime morph - xenotype selector scopes the marking pickers to a race -->
                                <Label Text="{Loc 'slime-morph-label-xenotype'}" FontColorOverride="#9AA1B0" />
                                <OptionButton Name="XenotypeButton" HorizontalExpand="True" />
                            </GridContainer>

                            <BoxContainer Orientation="Horizontal" Margin="0 2">
                                <Label Text="{Loc 'slime-morph-label-height'}" FontColorOverride="#9AA1B0" MinSize="60 0" />
                                <Slider Name="HeightSlider" HorizontalExpand="True" VerticalAlignment="Center" />
                                <Label Name="HeightValue" MinSize="40 0" Align="Right" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" Margin="0 2">
                                <Label Text="{Loc 'slime-morph-label-weight'}" FontColorOverride="#9AA1B0" MinSize="60 0" />
                                <Slider Name="WidthSlider" HorizontalExpand="True" VerticalAlignment="Center" />
                                <Label Name="WidthValue" MinSize="40 0" Align="Right" />
                            </BoxContainer>

                            <Label Text="{Loc 'slime-morph-label-skin'}" FontColorOverride="#9AA1B0" Margin="0 4 0 0" />
                            <ColorSelectorSliders Name="SkinColorSelector" />

                            <!-- Pirate: slime morph - recolor body/eyes + every marking toward the body color -->
                            <Button Name="AdaptColorsButton" Text="{Loc 'slime-morph-button-adapt-colors'}"
                                    HorizontalExpand="True" Margin="0 6 0 0" />

                            <Label Text="{Loc 'slime-morph-label-eyes'}" FontColorOverride="#9AA1B0" Margin="0 4 0 0" />
                            <ColorSelectorSliders Name="EyeColorSelector" />

                            <BoxContainer Name="MarkingPickers" Orientation="Vertical" />
                        </BoxContainer>
                    </ScrollContainer>

                </BoxContainer>
            </PanelContainer>

            <!-- RIGHT: preview + studied appearances (narrow) -->
            <PanelContainer HorizontalExpand="True" SizeFlagsStretchRatio="1" MinWidth="250">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#21242D" BorderColor="#2E323D" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical">

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#272B35" BorderColor="#6F9FE0" BorderThickness="0 0 0 2"
                                              ContentMarginLeftOverride="13" ContentMarginRightOverride="13"
                                              ContentMarginTopOverride="9" ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <Label Text="{Loc 'slime-morph-section-remembered'}" FontColorOverride="#6F9FE0" />
                    </PanelContainer>

                    <!-- Preview of what we'd end up looking like -->
                    <PanelContainer HorizontalExpand="True" Margin="8">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#15171D" BorderColor="#2E323D" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <SpriteView Name="Preview" Scale="3 3" MinSize="0 150"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" OverrideDirection="South" />
                    </PanelContainer>

                    <BoxContainer Orientation="Vertical" Margin="8 0 8 8" VerticalExpand="True">
                        <ItemList Name="RememberedList" VerticalExpand="True" SelectMode="Single" />
                        <!-- Pirate: slime morph - single commit button (Mimic) + Reset -->
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 8 0 0">
                            <Button Name="MimicButton" Text="{Loc 'slime-morph-button-mimic'}" HorizontalExpand="True" />
                            <Button Name="ResetButton" Text="{Loc 'slime-morph-button-reset'}" HorizontalExpand="True" />
                        </BoxContainer>
                        <!-- Pirate: slime morph - save current look / forget selected -->
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 8 0 0">
                            <Button Name="SaveButton" Text="{Loc 'slime-morph-button-save'}" HorizontalExpand="True" />
                            <Button Name="ForgetButton" Text="{Loc 'slime-morph-button-forget'}" HorizontalExpand="True" Disabled="True" />
                        </BoxContainer>
                        <!-- Pirate: slime morph - import/export a look to/from a .yml file -->
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 8 0 0">
                            <Button Name="ImportButton" Text="{Loc 'slime-morph-button-import'}" HorizontalExpand="True" />
                            <Button Name="ExportButton" Text="{Loc 'slime-morph-button-export'}" HorizontalExpand="True" />
                        </BoxContainer>
                        <Button Name="RevertButton" Text="{Loc 'slime-morph-button-revert'}" Margin="0 8 0 0" />
                    </BoxContainer>

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#272B35" BorderColor="#2E323D" BorderThickness="0 1 0 0"
                                              ContentMarginLeftOverride="13" ContentMarginRightOverride="13"
                                              ContentMarginTopOverride="8" ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <!-- Short one-line hint; its natural width stays under the left content's, so it
                             doesn't skew the 50/50 split (a long label would - see git history). -->
                        <Label Text="{Loc 'slime-morph-remembered-hint'}" StyleClasses="LabelSubText"
                               FontColorOverride="#6B7383" />
                    </PanelContainer>

                </BoxContainer>
            </PanelContainer>

        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
