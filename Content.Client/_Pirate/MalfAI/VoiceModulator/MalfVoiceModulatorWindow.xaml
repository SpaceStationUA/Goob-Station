<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="Voice Modulator"
               MinSize="420 300"
               SetSize="500 420">
  <PanelContainer Name="RootBackdrop">
    <PanelContainer.PanelOverride>
      <gfx:StyleBoxFlat BackgroundColor="#000000FF" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical" Margin="8,8,8,8">
      <Label Name="HeaderLabel" Text="Enter new AI name:" HorizontalExpand="True" />
      <LineEdit Name="NameEdit" PlaceHolder="e.g. Central Command AI" HorizontalExpand="True" Margin="0,4,0,8"/>
      <Button Name="ConfirmButton" Text="Confirm" HorizontalAlignment="Right" MinWidth="88" Margin="0,0,0,8"/>
      <Label Text="{Loc 'malf-voice-speech-style'}" />
      <OptionButton Name="VerbSelector" HorizontalExpand="True" />
      <Label Text="{Loc 'malf-voice-speech-sound'}" Margin="0,6,0,0" />
      <OptionButton Name="SoundSelector" HorizontalExpand="True" />
      <Label Text="{Loc 'malf-voice-job-icon'}" Margin="0,6,0,0" />
      <OptionButton Name="JobIconSelector" HorizontalExpand="True" />
      <BoxContainer Orientation="Horizontal" Margin="0,8,0,0">
        <Button Name="AccentButton" Text="Block accent" ToggleMode="True" HorizontalExpand="True" />
        <Button Name="ActiveButton" Text="Enable voice modulator" ToggleMode="True" HorizontalExpand="True" Margin="6,0,0,0" />
      </BoxContainer>
    </BoxContainer>
  </PanelContainer>
</controls:FancyWindow>
