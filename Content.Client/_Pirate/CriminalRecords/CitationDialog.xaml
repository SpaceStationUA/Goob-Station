<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'criminal-records-citation-issue'}"
                      MinSize="420 300"
                      SetSize="420 300">
    <BoxContainer Orientation="Vertical"
                  Margin="8"
                  SeparationOverride="6">
        <GridContainer Columns="2"
                       HSeparationOverride="8"
                       VSeparationOverride="6">
            <Label Text="{Loc 'criminal-records-citation-dialog-reason'}"
                   FontColorOverride="DarkGray" />
            <LineEdit Name="ReasonInput"
                      HorizontalExpand="True" />
            <Label Text="{Loc 'criminal-records-citation-dialog-fine'}"
                   FontColorOverride="DarkGray" />
            <LineEdit Name="FineInput"
                      HorizontalExpand="True" />
        </GridContainer>
        <Label Text="{Loc 'criminal-records-citation-dialog-details'}"
               FontColorOverride="DarkGray" />
        <TextEdit Name="DetailsInput"
                  VerticalExpand="True"
                  HorizontalExpand="True"
                  MinHeight="80" />
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="4">
            <Label Name="Counter"
                   HorizontalExpand="True"
                   FontColorOverride="DarkGray" />
            <Button Name="IssueButton"
                    Text="{Loc 'criminal-records-citation-dialog-confirm'}"
                    StyleClasses="OpenRight" />
            <Button Name="CancelButton"
                    Text="{Loc 'quick-dialog-ui-cancel'}"
                    StyleClasses="OpenLeft" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
