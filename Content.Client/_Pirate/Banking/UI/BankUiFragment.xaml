<ui1:BankUiFragment xmlns="https://spacestation14.io"
                   xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                   xmlns:ui1="clr-namespace:Content.Client._Pirate.Banking.UI"
                   Orientation="Vertical"
                   HorizontalExpand="True"
                   VerticalExpand="True"
                   Margin="4">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
        <controls:StripeBack SetHeight="44">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 0">
                <Label Text="{Loc 'bank-program-ui-title'}"
                       StyleClasses="LabelHeading"
                       HorizontalExpand="True"
                       VerticalAlignment="Center" />
                <Label Name="LinkedAccountNumberLabel"
                       StyleClasses="LabelSubText"
                       Visible="False"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0" />
                <Button Name="HeaderActionButton"
                        MinSize="30 30"
                        MaxSize="30 30"
                        StyleClasses="OpenBoth"
                        VerticalAlignment="Center"
                        ToolTip="{Loc 'bank-program-ui-link-account'}">
                    <TextureRect Name="LinkAccountIcon"
                                 TexturePath="/Textures/Interface/VerbIcons/plus.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 SetSize="12 12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    <TextureRect Name="LinkBackIcon"
                                 TexturePath="/Textures/Interface/Default/left_arrow.svg.192dpi.png"
                                 Visible="False"
                                 Stretch="KeepAspectCentered"
                                 SetSize="12 12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                </Button>
            </BoxContainer>
        </controls:StripeBack>
        <BoxContainer Name="AccountOverview" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
            <BoxContainer Name="LinkedAccount" Orientation="Vertical" Visible="False">
                <RichTextLabel Name="LinkedAccountNameLabel" />
                <RichTextLabel Name="LinkedAccountBalanceLabel" />
            </BoxContainer>
            <RichTextLabel Name="NoLinkedAccountLabel" Visible="False" />
            <RichTextLabel Name="AccountLinkResultLabel" Visible="False" />
            <BoxContainer Name="TransactionHistory" Orientation="Vertical" Visible="False" VerticalExpand="True" SeparationOverride="4">
                <controls:HighDivider />
                <Control HorizontalExpand="True" VerticalExpand="True" MinHeight="160">
                    <Label Name="NoTransactionsLabel"
                           Text="{Loc 'bank-program-ui-history-empty'}"
                           StyleClasses="LabelWeak"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <ScrollContainer Name="TransactionsScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Visible="False">
                        <BoxContainer Name="TransactionEntries" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                    </ScrollContainer>
                </Control>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="AccountLink" Orientation="Vertical" Visible="False" HorizontalExpand="True">
            <Label Text="{Loc 'bank-program-ui-link-account'}" StyleClasses="LabelHeading" />
            <RichTextLabel Name="AccountLinkMessageLabel" />
            <LineEdit Name="AccountLineEdit" HorizontalExpand="True" PlaceHolder="{Loc 'bank-program-ui-account-number'}" />
            <LineEdit Name="PinLineEdit" HorizontalExpand="True" PlaceHolder="PIN" />
            <Button Name="LinkConfirmButton" HorizontalAlignment="Right" Text="{Loc 'bank-program-ui-link-confirm'}" />
        </BoxContainer>
    </BoxContainer>
</ui1:BankUiFragment>
