<BoxContainer xmlns="https://spacestation14.io"
        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        Orientation="Horizontal"
        HorizontalExpand="true"
        MinHeight="64"
        Margin="5">
    <AnimatedTextureRect Name="Icon" SetSize="48 48" Margin="0 0 8 0"/>
    <Label Name="Title" HorizontalExpand="True"/>
    <BoxContainer Orientation="Vertical" Margin="5">
        <Button Name="CompleteButton" Text="{Loc 'contracts-complete'}"/>
        <controls:ConfirmButton Name="AbandonButton" Text="{Loc 'contracts-abandon'}" ConfirmationText="{Loc 'contracts-abandon-confirm'}"/>
    </BoxContainer>
</BoxContainer>
