<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         HorizontalExpand="True">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Name="PersonalNotes" Access="Public" Orientation="Vertical">
            <Label Text="{Loc 'character-info-editor-personal-notes-label'}"/>
            <TextEdit Name="PersonalNotesInput" Access="Public" MinSize="220 140" Margin="10"
                      HorizontalExpand="True" VerticalExpand="True"/>
        </BoxContainer>
        <BoxContainer Name="OOCNotes" Access="Public" Orientation="Vertical">
            <Label Text="{Loc 'character-info-editor-ooc-notes-label'}"/>
            <TextEdit Name="OOCNotesInput" Access="Public" MinSize="220 140" Margin="10"
                      HorizontalExpand="True" VerticalExpand="True"/>
        </BoxContainer>
    </BoxContainer>
</Control>
