diff --git a/Resources/Prototypes/_Pirate/Radio/stations.yml b/Resources/Prototypes/_Pirate/Radio/stations.yml
new file mode 100644
index 0000000000..9d45fc8e71
--- /dev/null
+++ b/Resources/Prototypes/_Pirate/Radio/stations.yml
@@ -0,0 +1,165 @@
+# Curated internet-radio stations for the Pirate PDA radio app.
+#
+# HARD REQUIREMENTS (do not add a station that breaks these):
+#   * url MUST be https:// (res:// pages are a Secure context; http is
+#     blocked as mixed content).
+#   * the stream MUST be an open codec (Ogg Vorbis / Opus / FLAC-in-Ogg).
+#     Stock CEF ships no MP3/AAC decoders, so an MP3/AAC stream fails with
+#     NotSupportedError.
+#   * every URL below was byte-verified (OggS magic) with a live range GET
+#     on 2026-09-20.
+#
+# One entry per station: Lassul's .ogg/.opus mounts all carry the same
+# program, so only one is listed. Sources found via radio-browser.info
+# (community directory) and verified by hand.
+#
+# These load offline and are always offered; the server additionally queries
+# radio-browser.info for more Ogg stations when
+# pirate.radio_remote_catalog is on, and only offers remote ones whose
+# stream still answers with Ogg magic bytes.
+
+- type: radioStation
+  id: lassul-radio
+  label: Lassul Radio
+  genre: various / eclectic
+  url: https://radio.lassul.us/radio.ogg
+  featured: true
+
+- type: radioStation
+  id: nightride
+  label: Nightride FM
+  genre: darksynth / retrowave
+  url: https://stream.nightride.fm/nightride.ogg
+  featured: true
+
+- type: radioStation
+  id: nightride-chillsynth
+  label: Nightride Chill Synth
+  genre: chillwave / synth
+  url: https://stream.nightride.fm/chillsynth.ogg
+  featured: true
+
+- type: radioStation
+  id: nightride-darksynth
+  label: Nightride Dark Synth
+  genre: darksynth
+  url: https://stream.nightride.fm/darksynth.ogg
+
+# Nightride note: ~1 Mbps streams; expect buffering on slow connections.
+
+- type: radioStation
+  id: plaza-one
+  label: Nightwave Plaza
+  genre: vaporwave
+  url: https://radio.plaza.one/ogg
+  featured: true
+
+- type: radioStation
+  id: listen-moe
+  label: LISTEN.moe J-Pop
+  genre: j-pop / anime
+  url: https://listen.moe/stream
+  featured: true
+
+- type: radioStation
+  id: listen-moe-kpop
+  label: LISTEN.moe K-Pop
+  genre: k-pop
+  url: https://listen.moe/kpop/stream
+
+- type: radioStation
+  id: chinese-music-world
+  label: Chinese Music World
+  genre: chinese / traditional
+  url: https://radio.chinesemusicworld.com/chinesemusic.ogg
+
+- type: radioStation
+  id: chifuru
+  label: Chifuru!
+  genre: anime radio / jpop
+  # Direct Ogg — the directory lists the bare IP (cert mismatch → fails);
+  # the nginx 301 on the .fun host renames the mount, so pin the final URL.
+  url: https://chiafuru.fun/stream/nanahira-releases@256
+
+- type: radioStation
+  id: lounge-streams-nl
+  label: Live-Streams Lounge
+  genre: lounge / chill
+  url: https://mscp4.live-streams.nl:8142/lounge.ogg
+
+- type: radioStation
+  id: new-age-jazz
+  label: New Age Radio Jazz
+  genre: jazz (flac)
+  url: https://stream.newageradio.gr/listen/jazz/radio.flac
+
+# ---- Server-relayed stations (transcoded from MP3/AAC) ----
+#
+# These streams are MP3/AAC, which stock CEF cannot decode. The server
+# fetches them, transcodes to Opus/WebM and relays the bytes over the game
+# connection; requires pirate.radio_ffmpeg_path to be set on the server.
+# Each URL was byte-verified (MPEG sync / ADTS sync) with a live GET on
+# 2026-09-20. Note: ffmpeg follows redirects, so 302 hops (laut.fm) work.
+
+- type: radioStation
+  id: gotanno
+  label: Gotanno FM 89.2
+  genre: indie pop / jpop
+  transcode: true
+  url: https://radio.gotanno.love/
+
+- type: radioStation
+  id: yumi-co
+  label: Yumi Co. Radio
+  genre: anime groove / city pop
+  transcode: true
+  url: https://yumicoradio.net/stream
+
+- type: radioStation
+  id: roks-hard-heavy
+  label: Radio ROKS Hard'n'Heavy
+  genre: hard rock
+  transcode: true
+  url: http://online.radioroks.ua/RadioROKS_HardnHeavy_HD
+
+- type: radioStation
+  id: brokenbeats
+  label: Brokenbeats
+  genre: drum and bass / downtempo
+  transcode: true
+  url: https://stream.brokenbeats.net/tune
+
+- type: radioStation
+  id: melodia-fm
+  label: Melodia FM
+  genre: pop
+  transcode: true
+  url: https://online.melodiafm.ua/MelodiaFM
+
+- type: radioStation
+  id: jazz-fm-1046
+  label: Jazz FM 104.6
+  genre: jazz
+  transcode: true
+  url: http://online.radiojazz.ua/RadioJazz
+
+- type: radioStation
