+
+//Hidden command to unlock all levels.
+function unlockAllLevels() {
+	if (amountOfLevelsSolved != levels.length) {
+		forceUnlockAllLevels = true;
+		if (level == 0) {
+			loadLevel(0);
+		}
+	}
