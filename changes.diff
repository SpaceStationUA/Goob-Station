+		}
+	}
+
+	//Rubble
+	for(let i = 0; i != rubble.length; i++) {
+		levelCtx.drawImage(rubbleCanvas, PosX(rubble[i].x) - rubbleMargin * 0.5, PosY(rubble[i].y) - rubbleMargin * 0.5);
+	}
+
+	//Target
+	for(let i = 0; i != targets.length; i++) {
+		if (hasBox(targets[i].x, targets[i].y)) {
