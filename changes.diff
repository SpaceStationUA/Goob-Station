+		bagColor = cc[Math.floor(Math.random() * cc.length)]
+		if (bagColor != bgColor && bagColor != planetColor) break
+	}
+
+	smallPlanet = Math.random() < 0.5 ? -1 : 1
+	planetCraters = Math.random() < 0.5 ? -1 : 1
+	sunCraters = Math.random() < 0.5 ? -1 : 1
