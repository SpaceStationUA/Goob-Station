+	titlePos.x = lerp(titlePos.x, newX, lerpSpeed)
+	titlePos.y = lerp(titlePos.y, newY, lerpSpeed)
+
+	ctx.font = "bold 170px Tahoma";
+
+	ctx.textAlign = "center";
+	ctx.save()
+	ctx.fillText("PACKA", titlePos.x, titlePos.y);
+	ctx.restore()
+	ctx.save()
+	ctx.font = "bold 118px Tahoma";
