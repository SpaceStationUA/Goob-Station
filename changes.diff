+        }
+        // Dispatch by kind — the console verb must accept everything the
+        // per-item verbs accept (paper worked; pad/photo puked "hold paper").
+        if (TryComp<PaperComponent>(item, out var paper))
+        {
+            FilePaper((item, paper), console, user);
