--- /dev/null
+++ b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/base_borg_chassis.ftl
@@ -0,0 +1,6 @@
+ent-BaseBorgChassis = кіборг
+    .desc = Людино-машинний гібрид, який допомагає в роботі станції. Їм подобається, коли їх просять повторювати свої закони знову і знову.
+ent-BaseBorgChassisNotIonStormable = кіборг
+    .desc = Гібрид людини та машини, що допомагає в діяльності станції. Вони люблять, коли їх просять повторювати свої закони знову і знову.
+ent-BaseXenoborgChassis = ксеноборг
+    .desc = Гібрид людини й машини, що прагне самовідтворення. Вони люблять витягувати мозки, щоб вставляти їх у свіжі шасі ксеноборгів і нарощувати свою армію.
diff --git a/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/borg_chassis.ftl b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/borg_chassis.ftl
new file mode 100644
index 0000000000..e83e3c8f21
--- /dev/null
+++ b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/borg_chassis.ftl
@@ -0,0 +1,30 @@
+ent-BorgChassisDerelict = покинутий кіборг
+    .desc = Гібрид людини та машини, який допомагає в діяльності станції. Цей знаходиться у стані сильного занепаду.
+ent-BorgChassisEngineer = кіборг-інженер
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisGeneric = загальний кіборг
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisJanitor = кіборг-прибиральник
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisMedical = медичний кіборг
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisMining = кіборг-утилізатор
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisService = сервісний кіборг
+    .desc = { ent-BaseBorgChassis.desc }
+ent-BorgChassisSyndicateAssault = синдикатський штурмовий кіборг
+    .desc = Худорлява, жорстока машина для вбивства з доступом до різноманітних смертоносних модулів.
+ent-BorgChassisSyndicateMedical = синдикатський медичний кіборг
+    .desc = Бойовий медичний кіборг. Має обмежений наступальний потенціал, але з лишком компенсує його своїми можливостями підтримки.
+ent-BorgChassisSyndicateSaboteur = синдикатський диверсійний кіборг
+    .desc = Обтічний інженерний кіборг, оснащений прихованими модулями. Проектор-хамелеон дозволяє йому маскуватися під кіборга "НаноТрейзен".
+ent-EngineeringBorgChassisDerelict = покинутий інженерний кіборг
+    .desc = Гібрид людини й машини, що допомагає інженерному відділу. Цей, здається, має шматки дивних кристалів, що вкривають його поверхню.
+ent-JanitorBorgChassisDerelict = покинутий прибиральний кіборг
+    .desc = Гібрид людини й машини, що допомагає сервісному відділу. Він у більшому безладі, ніж будь-що, що може прибрати.
+ent-MedicalBorgChassisDerelict = покинутий медичний кіборг
+    .desc = Гібрид людини й машини, що допомагає медичному відділу. Голки цього не виглядають дуже стерильними.
+ent-MiningBorgChassisDerelict = покинутий утилізаційний кіборг
+    .desc = Гібрид людини й машини, що допомагає вантажному відділу. Цей побачив неправильний бік шматка гібтоніту.
+ent-SyndicateAssaultBorgChassisDerelict = покинутий штурмовий кіборг Синдикату
+    .desc = Худа й люта машина для вбивства з доступом до різноманітних смертоносних модулів. Цей радше іржаво-помаранчевий, ніж криваво-червоний.
diff --git a/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/xenoborgs.ftl b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/xenoborgs.ftl
new file mode 100644
index 0000000000..fd3a0c6579
--- /dev/null
+++ b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/xenoborgs.ftl
@@ -0,0 +1,8 @@
+ent-XenoborgEngi = інженерний ксеноборг
+    .desc = Гібрид людини й машини, що прагне самовідтворення. Вони люблять витягувати мозки, щоб вставляти їх у свіжі шасі ксеноборгів і нарощувати свою армію. Цей, схоже, інженерного типу, адже має більше інструментів для підтримки інших ксеноборгів.
+ent-XenoborgHeavy = важкий ксеноборг
+    .desc = Гібрид людини й машини, що прагне самовідтворення. Вони люблять витягувати мозки, щоб вставляти їх у свіжі шасі ксеноборгів і нарощувати свою армію. Цей тип має важкі лазери й вкритий товстими бронеплитами. Можливо, він міцніший, але його швидкість відповідає його силі.
+ent-XenoborgScout = розвідувальний ксеноборг
+    .desc = Гібрид людини й машини, що прагне самовідтворення. Вони люблять витягувати мозки, щоб вставляти їх у свіжі шасі ксеноборгів і нарощувати свою армію. Це розвідувальний тип, його спритні рушії дозволяють швидко рухатися в космосі.
+ent-XenoborgStealth = стелс-ксеноборг
+    .desc = Гібрид людини й машини, що прагне самовідтворення. Вони люблять витягувати мозки, щоб вставляти їх у свіжі шасі ксеноборгів і нарощувати свою армію. Це стелс-тип. Його броня мерехтить на світлі, наче з матеріалу, якого ви ще не бачили.
