+var levels = [];
+levels.push([
+	{gates: [0, 1, 3, 6, 11, 14], levelSpread: [1, 2, 5, 10, 17, 21], yOff: -2}, //Level select
+	"",
+	"....1.",
+	"",
+	"...222..",
+	"....p",
+	"..33333..",
+	"",
+	".4444444.",
+	".........",
+	".5555.6.#",
+	"........#",
