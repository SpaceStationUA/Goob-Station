+		} else {
+			levelCtx.globalAlpha = 1;
+		}
+		levelCtx.drawImage(boxCanvas, PosX(gates[i].x) - boxMargin * 0.5, PosY(gates[i].y) - boxMargin * 0.5);
+	}
+	levelCtx.globalAlpha = 1;
+
+	//Walls
