diff --git a/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/base_borg_chassis.ftl b/Resources/Locale/uk-UA/prototypes/entities/mobs/cyborgs/base_borg_chassis.ftl
new file mode 100644
