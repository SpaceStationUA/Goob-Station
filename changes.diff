@@ -0,0 +1,95 @@
+/* Radio page styles - built on the theme tokens; no raw colors. */
+
+* { box-sizing: border-box; }
+html, body {
+  margin: 0; padding: 0; height: 100%;
+  background: var(--bg); color: var(--text);
+  font-family: "Segoe UI", system-ui, sans-serif;
+  overflow: hidden;
+  user-select: none;
+}
+/* Solid mounts into #root; the old page was its own flex column. */
+#root { display: flex; flex-direction: column; height: 100%; }
+
+/* Content column: the ONLY scroller must be .list (the watermark inside
+   GameWindow is pinned to the window shell, so it must not move). */
+.app { display: flex; flex-direction: column; height: 100%; flex: 1; min-height: 0; }
+
+.station-label { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.genre-line, .song-line { font-size: 11px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.status-line { font-size: 11px; color: var(--dim); }
+
+.now {
+  padding: 10px 12px;
+  background: linear-gradient(180deg, var(--panel2), var(--panel));
+  border-bottom: 1px solid var(--line);
+  display: flex; align-items: center; gap: 10px;
+}
+.eq { width: 26px; height: 22px; display: flex; align-items: flex-end; gap: 3px; }
+.eq i {
+  display: block; width: 4px; background: var(--accent2);
+  height: 4px; border-radius: var(--radius);
+  animation: bounce 900ms ease-in-out infinite;
+}
+.eq i:nth-child(2) { animation-delay: 150ms; }
+.eq i:nth-child(3) { animation-delay: 320ms; }
+.eq i:nth-child(4) { animation-delay: 470ms; }
+.eq.paused i { animation-play-state: paused; height: 4px !important; opacity: .4; }
+@keyframes bounce { 0%,100% { height: 4px; } 50% { height: 20px; } }
+
+.meta { flex: 1; min-width: 0; }
+.volpct { font-size: 11px; color: var(--dim); width: 30px; text-align: right; }
+.vol { flex: 1; accent-color: var(--accent); }
+
+.controls {
+  display: flex; align-items: center; gap: 8px;
+  padding: 8px 12px;
+  border-bottom: 1px solid var(--line);
+}
+
+.tabs { display: flex; border-bottom: 1px solid var(--line); }
+.tabs .tab {
+  flex: 1; text-align: center; padding: 7px 0;
+  font-size: 12px; color: var(--dim); cursor: pointer;
+  background: var(--panel);
+  border: none; border-radius: 0;
+}
+.tabs .tab.active { background: var(--panel2); color: var(--accent2); font-weight: 600; }
+
+.list {
+  flex: 1; min-height: 0; overflow-y: auto; padding: 6px;
+  position: relative; z-index: 1;
+}
+.station-row {
+  padding: 7px 10px; border-radius: var(--radius); cursor: pointer;
+  display: flex; align-items: center; gap: 8px;
+}
+.station-row:hover { background: var(--panel2); }
+.station-row.active { background: var(--accent); color: #fff; }
+.station-row.active .g { opacity: .75; color: #fff; }
+.station-row.dead { opacity: .35; cursor: default; }
+.station-row .name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
+.station-row .g { font-size: 11px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 42%; }
+.star { color: var(--accent2); cursor: pointer; padding: 0 2px; font-size: 14px; flex: none; }
+.star.off { color: var(--dim); }
+.station-row.active .star { color: #fff; }
+.genre-row {
+  padding: 8px 10px; border-radius: var(--radius); cursor: pointer;
+  display: flex; align-items: center; gap: 8px;
+}
+.genre-row:hover { background: var(--panel2); }
+.genre-row .gname { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
+.genre-row .cnt { font-size: 11px; color: var(--dim); }
+.back { padding: 6px 10px; font-size: 12px; color: var(--dim); cursor: pointer; flex: none; }
+.back:hover { color: var(--accent2); }
+.list::-webkit-scrollbar { width: 8px; }
+.list::-webkit-scrollbar-thumb { background: var(--panel2); border-radius: var(--radius); }
+
+.theme-switch { display: inline-flex; gap: 4px; margin-left: 8px; }
+.theme-chip {
+  background: var(--panel2); color: var(--dim);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 2px 8px; font-size: 11px; cursor: pointer;
+}
+.theme-chip.active { color: var(--text); border-color: var(--accent); }
diff --git a/Content.Pirate.Client/_Pirate/WebUI/Ui/src/ThemePicker/App.tsx b/Content.Pirate.Client/_Pirate/WebUI/Ui/src/ThemePicker/App.tsx
new file mode 100644
index 0000000000..d41bea23b1
--- /dev/null
+++ b/Content.Pirate.Client/_Pirate/WebUI/Ui/src/ThemePicker/App.tsx
@@ -0,0 +1,94 @@
+import { createSignal, For, Show, onCleanup } from "solid-js";
+import { postAction } from "../lib/bridge";
+import { applyThemeId, ThemeProvider } from "../lib/theme";
+import { GameWindow, Icon } from "../lib/kit";
+import { IoSunny, IoMoon } from "solid-icons/io";
+import "./picker.css";
+
+/** Theme name/id prettifier; the description strings live here so server
+ * stays terse. Keep in sync with Resources/Prototypes/_Pirate/webui.yml. */
+const LABELS: Record<string, string> = {
+  PirateNtWeb: "NanoTrasen blue",
+  PirateNtAmber: "NT solar (amber)",
+  PirateSyndiWeb: "Syndicate red",
+};
+
+// The page self-themes to the device's current skin via the initial state.
+interface ThemeState {
+  current: string;
+  allowed: string[];
+}
+
+export default function App() {
+  const [state, setState] = createSignal<ThemeState | null>(null);
+  const [busy, setBusy] = createSignal(false);
+
+  window.__themeSetState = (json: string | ThemeState) => {
+    try {
+      onState(typeof json === "string" ? JSON.parse(json) : json);
+    } catch { /* ignore */ }
+  };
+
+  // Pull-based state: pushes to a hidden page can be swallowed, so the
+  // page keeps polling "list" until state lands and pulls again whenever
+  // the state goes away (fresh mounts race the first server reply).
+  const pull = async () => {
+    try {
+      const res = await postAction<ThemeState>("list", {});
+      if (res.ok && res.data && (res.data as ThemeState).current)
+        onState(res.data as ThemeState);
+    } catch { /* retry next tick */ }
+  };
+  const syncTimer = window.setInterval(() => {
+    try { if (!state()) void pull(); } catch { /* page teardown */ }
+  }, 800);
+  onCleanup(() => window.clearInterval(syncTimer));
+  void pull();
+  window.addEventListener("tui-push", (ev) => {
+    const detail = (ev as CustomEvent).detail ?? {};
+    void postAction("dbg", "tui-push name=" + (detail.name ?? "?"));
+    if ((detail.name ?? "") !== "theme-state") return;
+    onState(detail.payload as ThemeState);
+  });
+
+  function onState(s: ThemeState): void {
+    setState(s);
+    // Re-skin the picker itself to the device's current theme.
+    applyThemeId(s.current);
+    setBusy(false);
+    void postAction("dbg", "theme-state n=" + s.allowed.length + " cur=" + s.current);
+  }
+
+  // Page is up: engine re-pull state (mirrors the radio page's handshake).
+
+  postAction("ready", {});
+
+  return (
+    <ThemeProvider>
+      <GameWindow>
+        <div class="picker">
+          <p class="hint">Applies to this PDA's windows (radio and future apps).</p>
+          <div class="list">
+            <For each={state()?.allowed ?? []}>{(t) =>
+              <button
+                class={"theme-card" + (state()?.current === t ? " active" : "")}
+                disabled={busy() || state()?.current === t}
+                onClick={async () => {
+                  setBusy(true);
+                  await postAction("set", { theme: t });
+                }}
+              >
+                <Icon p={t === "PirateSyndiWeb" ? <IoMoon /> : <IoSunny />} />
+                <span class="name">{LABELS[t] ?? t}</span>
+                <Show when={state()?.current === t}><span class="cur">current</span></Show>
+              </button>
+            }</For>
+          </div>
+          <Show when={!state()}>
+            <p class="hint">waiting for device state…</p>
+          </Show>
+        </div>
+      </GameWindow>
+    </ThemeProvider>
+  );
+}
