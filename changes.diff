+    /// <summary>The full station list (pins + remote cache per cvar).</summary>
+    private List<PirateRadioStationEntry> StationsFor()
+    {
+        var stations = Pinned();
+        if (_cache != null)
+            stations.AddRange(_cache);
+        return stations;
+    }
