+//https: //stackoverflow.com/questions/9960908/permutations-in-javascript/37580979#37580979
+function permute(_array) {
+	let length = _array.length,
+		result = [_array.slice()],
+		c = new Array(length).fill(0),
+		i = 1,
+		k, p;
+
+	while (i < length) {
+		if (c[i] < i) {
+			k = i % 2 && c[i];
+			p = _array[i];
+			_array[i] = _array[k];
+			_array[k] = p;
+			++c[i];
+			i = 1;
+			result.push(_array.slice());
+		} else {
+			c[i] = 0;
+			++i;
+		}
+	}
+	return result;
+}
