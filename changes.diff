+/* Design tokens: semantic CSS variables per theme.
+ * Components reference ONLY these names - raw colors live nowhere else.
+ *
+ *   bg/bgSoft  surfaces, panel/panel2 raised surfaces, line boundaries
+ *   text/dim   content hierarchy, accent/accent2 brand color, danger
+ *   fail       "danger" state color for ProgressBar etc.
+ *   radius     corner geometry (Syndicate skews via clip-path in kit.css)
+ *
+ * Themes:
+ *   nt       NanoTrasen - industrial functionalism: cool grays, steel blue,
+ *            square corners, deliberate borders.
+ *   syndi    Syndicate - aggressive militarism: coal black + crimson,
+ *            chamfered edges, hot orange second accent.
+ */
+
+:root, .theme-nt {
+  --bg: #14171c;
+  --bg-soft: #10131a;
+  --panel: #1c202a;
+  --panel2: #252b38;
+  --line: #0a0c10;
+  --text: #e6e9ee;
+  --dim: #8b93a1;
+  --accent: #4a8fd9;
+  --accent2: #8ec1ef;
+  --danger: #d9534f;
+  --radius: 2px;
+}
+
+.theme-syndi {
