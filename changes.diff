diff --git a/Resources/Textures/Shaders/opiatenod.swsl b/Resources/Textures/Shaders/opiatenod.swsl
new file mode 100644
index 0000000000..298f40514a
--- /dev/null
+++ b/Resources/Textures/Shaders/opiatenod.swsl
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+uniform sampler2D SCREEN_TEXTURE;
+uniform highp float nodPower; // 0..1, driven by remaining opiate effect time
+
+// Progressive blur: strength ramps with nodPower
+const highp float BlurStrength = 2.5; // in pixels
+
+// Slow head-nodding drift: the screen sinks down and bobs back up
+const highp float NodStrength = 0.03;
+const highp float NodFreq = 0.7;
+
+// Double vision: a second smeared copy of what you see
+const highp float DoubleVisionStrength = 0.03;
+const highp float DoubleVisionFreq = 0.9;
+
+// Vignette: edges of vision darken and close in at high doses
+const highp float VignetteStart = 0.35;
+const highp float VignetteStrength = 0.85;
+
+void fragment() {
+    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
+
+    // Head-nod: an asymmetric downward bob, like you keep sinking and drifting back
+    highp float nod = pow(0.5 - 0.5 * cos(TIME * NodFreq * 6.2831853), 2.0);
+    highp vec2 drift = vec2(0.0, NodStrength * nodPower * nod);
+
+    // Double vision: a ghost image drifting horizontally alongside
+    highp float dbl = DoubleVisionStrength * nodPower * sin(TIME * DoubleVisionFreq * 3.0);
+
+    // Box blur around the drifting sample point
+    highp vec2 uv = coord + drift;
+    highp vec2 blur = BlurStrength * SCREEN_PIXEL_SIZE;
+    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, uv) * 0.35;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + vec2(blur.x, 0.0)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv - vec2(blur.x, 0.0)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + vec2(0.0, blur.y)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + blur) * 0.05;
+
+    // Ghost sample: the whole screen drifts smoothly from side to side, no seam
+    highp vec4 ghost = zTextureSpec(SCREEN_TEXTURE, uv + vec2(dbl, 0.0));
+    color = mix(color, ghost, 0.4 * nodPower);
+
+    // Vignette closing in
+    highp vec2 centered = coord - vec2(0.5);
+    highp float dist = length(centered) * 2.0;
+    highp float vig = smoothstep(VignetteStart, 1.1, dist) * VignetteStrength * nodPower;
+    color.rgb = mix(color.rgb, vec3(0.0, 0.0, 0.0), vig);
+
+    COLOR = color;
+}
diff --git a/Resources/Textures/Shaders/pirateroundwipe.swsl b/Resources/Textures/Shaders/pirateroundwipe.swsl
new file mode 100644
index 0000000000..012cb679e8
--- /dev/null
+++ b/Resources/Textures/Shaders/pirateroundwipe.swsl
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+uniform sampler2D artTexture; // the "before" frame (splash / lobby art)
+uniform highp float progress; // 0 = art fully opaque, 1 = art invisible
+uniform highp float maskMode; // 0 = dither cells, 1 = staggered bands, 2 = centered circle, 3 = sweep, 4 = precise stripes, 5 = art stripes
+uniform highp float seed;
+uniform highp vec2 artScale; // maps screen uv into the art's cover-cropped uv space
+uniform highp vec2 artOffset;
+
+const highp float CellSize = 6.0; // art is dithered in ~8px blocks; 6 reads well on both
+const highp float BandCount = 7.0;
+
+highp float hash(highp vec2 co) {
+    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
+}
+// mode 5: dissolve the art stripe-by-stripe. The lobby art's own diagonal color
+// bands (8 of them, slope ~0.135 uv) each vanish as a unit on their own timer,
+// with a per-pixel dither inside a short window; other stripes stay intact.
+highp float stripeArtMask(highp vec2 coord) {
+    highp float a = clamp(coord.x - coord.y * 0.135, 0.0, 0.9999);
+    highp float band = floor(a * 8.0);
+    highp float rng = hash(vec2(band, seed * 61.17));
+    // each stripe stays solid until its own start, then erases in a short window
+    highp float start = rng * 0.72;
+    highp float gone = clamp((progress - start) / 0.18, 0.0, 1.0);
+    // hold the value solid until the erase begins, then a tight pixel dither
+    if (gone <= 0.0)
+        return 1.0;
+    highp float pix = hash(floor(coord * SCREEN_PIXEL_SIZE) + band * 7.31);
+    return gone >= 1.0 ? 0.0 : (pix < gone ? 0.0 : 1.0);
+}
+
+// mode 4: precise pixel-locked vertical stripes. Each stripe dissolves from the
+// top down; a 12px fringe between the revealed and intact areas carries the
+// dither, everything else inside and outside the fringe stays solid.
+highp float stripeMask(highp vec2 coord) {
+    highp float stripeFrac = SCREEN_PIXEL_SIZE.x * 24.0;
+    highp float bx = floor(coord.x / stripeFrac);
+    highp float rng = hash(vec2(bx, seed * 61.17));
+    highp float r = hash(floor(coord * SCREEN_PIXEL_SIZE) + seed * 61.17);
+    highp float staggerSpan = 0.35;
+    highp float p = clamp(progress * (1.0 + staggerSpan) - rng * staggerSpan, 0.0, 1.0);
+    highp float fringe = SCREEN_PIXEL_SIZE.y * 12.0;
+    highp float diff = coord.y - p;
+    if (diff <= -fringe)
+        return 0.0;
+    if (diff >= fringe)
+        return 1.0;
+    return clamp(0.5 + diff / (2.0 * fringe) + (r - 0.5) * 0.9, 0.0, 1.0);
+}
+
+// normalized mask 0..1: pixels where mask > progress already show the game
+highp float mask(highp vec2 coord) {
+    highp vec2 cells = floor(coord * SCREEN_PIXEL_SIZE * 1080.0 / CellSize);
+    highp float r = hash(cells + seed * 61.17);
+
+    if (maskMode < 0.5) {
+        // chunky dither cells
+        return r;
+    }
+
+    if (maskMode > 0.5 && maskMode < 1.5) {
+        // staggered diagonal bands, dithered inside each band
+        highp float d = (coord.x + coord.y - 1.0) * 0.5; // along the diagonal
+        highp float band = floor(fract(d + seed * 0.173) * BandCount);
+        return fract(band * 0.61803 + r * 0.5 + 0.25);
+    }
+
+    if (maskMode > 1.5 && maskMode < 2.5) {
+        // growing circle from the center
+        highp vec2 centered = coord - vec2(0.5);
+        highp float dist = length(centered) * 2.0;
+        return clamp(dist / 1.05, 0.0, 1.0);
+    }
+
+    if (maskMode > 3.5 && maskMode < 4.5) {
+        return stripeMask(coord);
+    }
+
+    if (maskMode > 4.5 && maskMode < 5.5) {
+        return stripeArtMask(coord);
+    }
+
+    // sweep across, dithered at the edge
+    highp float along = clamp(coord.x * 0.75 + coord.y * 0.25, 0.0, 1.05);
+    return clamp(along / 1.05, 0.0, 1.0) * 0.5 + r * 0.5;
+}
+
+
+void fragment() {
+    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
+
+    // idle shimmer while the art is up and "still" (cover phase)
+    highp float idle = (1.0 - progress) * 0.0012;
+    highp vec2 artUv = (coord - vec2(0.5)) * artScale + vec2(0.5) + artOffset;
+    artUv.y += sin(TIME * 2.7 + seed * 10.0) * idle;
+    artUv.x += sin(TIME * 2.1 + seed * 7.0 + 1.3) * idle * 0.5;
+
+    highp vec4 art = zTextureSpec(artTexture, clamp(artUv, 0.0, 1.0));
+
+    // punch the dissolve through with a dithered edge, hard binary per cell
+    highp float m = mask(coord);
+    highp float edge = 0.02;
+    highp float t = smoothstep(m - edge, m + edge, progress);
+    highp float artAlpha = 1.0 - t;
+
+    COLOR = art * artAlpha;
+}
diff --git a/Resources/Textures/Shaders/stimrush.swsl b/Resources/Textures/Shaders/stimrush.swsl
new file mode 100644
index 0000000000..6717fad968
--- /dev/null
+++ b/Resources/Textures/Shaders/stimrush.swsl
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+uniform sampler2D SCREEN_TEXTURE;
+uniform highp float rushPower; // 0..1, driven by remaining stimulant effect time
+
+// Rapid small-amplitude vibration: the meth "shakes"
+const highp float VibStrength = 0.0035;
+const highp float VibFreq = 45.0;
+
+// Chip-module pixel jitter: the screen jitters along a coarse pixel grid
+const highp float JitterFps = 24.0;
+const highp float JitterCellSize = 8.0; // in pixels
+const highp float JitterStrength = 0.0015;
+
+highp float rand(highp vec2 co) {
+    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+void fragment() {
+    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
+
+    // Rapid vibration
+    highp vec2 vib = VibStrength * rushPower * vec2(
+        sin(TIME * VibFreq),
+        cos(TIME * VibFreq * 0.83 + 1.7));
+
+    // Stepped pixel jitter: quantized in time, per-cell random direction
+    highp float frame = floor(TIME * JitterFps);
+    highp vec2 cellId = floor(FRAGCOORD.xy / JitterCellSize);
+    highp float r = rand(cellId + frame * 0.6180339);
+    highp float ang = r * 6.2831853;
+    highp vec2 jitter = JitterStrength * rushPower * vec2(cos(ang), sin(ang));
+
+    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, coord + vib + jitter);
+
+    COLOR = color;
+}
diff --git a/Resources/Textures/Shaders/trippy.swsl b/Resources/Textures/Shaders/trippy.swsl
new file mode 100644
index 0000000000..e2b5ed5360
--- /dev/null
+++ b/Resources/Textures/Shaders/trippy.swsl
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+uniform sampler2D SCREEN_TEXTURE;
+uniform highp float tripPower; // 0..1, driven by remaining hallucination effect time
+
+// Chromatic aberration: color channels split away from each other toward the edges
+const highp float AberrationStrength = 0.005;
+
+// Kaleidoscope: the outer edge of the screen folds into mirrored segments
+const highp float KaleidoSegments = 8.0;
+const highp float KaleidoStart = 0.3; // fraction of screen radius where folding begins
+const highp float KaleidoBlend = 0.7; // how strongly the fold replaces the plain view
+
+void fragment() {
+    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
+    highp vec2 centered = coord - vec2(0.5);
+    highp float r = length(centered) * 2.0;
+    highp float a = atan(centered.y, centered.x);
+
+    // Kaleidoscope fold: mirror the angle into segments, applied near the screen edge
+    highp float seg = 6.2831853 / KaleidoSegments;
+    highp float fa = mod(a, seg);
+    fa = abs(fa - seg * 0.5);
+    highp vec2 kaledCoord = vec2(cos(fa), sin(fa)) * length(centered) + vec2(0.5);
+    highp float kamt = smoothstep(KaleidoStart, 0.75, r) * KaleidoBlend * tripPower;
+    highp vec2 uv = mix(coord, kaledCoord, kamt);
+
+    // Chromatic aberration: split channels radially, stronger at edges
+    highp vec2 dir = normalize(centered + vec2(0.0001, 0.0));
+    highp vec2 off = dir * AberrationStrength * tripPower * (0.3 + r);
+
+    highp vec4 base = zTextureSpec(SCREEN_TEXTURE, uv);
+    highp vec4 red = zTextureSpec(SCREEN_TEXTURE, uv + off);
+    highp vec4 blue = zTextureSpec(SCREEN_TEXTURE, uv - off);
+    COLOR = vec4(red.r, base.g, blue.b, base.a);
+}
diff --git a/Resources/Textures/Shaders/visionfade.swsl b/Resources/Textures/Shaders/visionfade.swsl
new file mode 100644
index 0000000000..14348853ef
--- /dev/null
+++ b/Resources/Textures/Shaders/visionfade.swsl
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+uniform sampler2D SCREEN_TEXTURE;
+uniform highp float fadePower; // 0..1, driven by remaining time until vision fails
+
+// Blurred vision: everything loses focus as your eyes water up
+const highp float BlurStrength = 3.0; // in pixels
+
+// Tunnel vision: the sight narrows as pain takes over
+const highp float TunnelStart = 0.2; // fraction of vision closing at low power
+const highp float TunnelEnd = 0.85; // fraction of vision closed at full power
+
+// Watery eyes: occasional watery refraction ripples
+const highp float TearStrength = 0.004;
+const highp float TearFreq = 3.0;
+
+void fragment() {
+    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
+
+    // Watery ripple: subtle slow vertical shimmer
+    highp vec2 ripple = TearStrength * fadePower * vec2(
+        0.0,
+        sin(coord.y * 40.0 + TIME * TearFreq) +
+        0.5 * sin(coord.x * 25.0 - TIME * TearFreq * 0.7));
+
+    // Blur around the rippled sample point
+    highp vec2 uv = coord + ripple;
+    highp vec2 blur = BlurStrength * fadePower * SCREEN_PIXEL_SIZE;
+    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, uv) * 0.35;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + vec2(blur.x, 0.0)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv - vec2(blur.x, 0.0)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + vec2(0.0, blur.y)) * 0.2;
+    color += zTextureSpec(SCREEN_TEXTURE, uv + blur) * 0.05;
+
+    // Tunnel vision: vignette advances inward with the power
+    highp vec2 centered = coord - vec2(0.5);
+    highp float dist = length(centered) * 2.0;
+    highp float edge = mix(TunnelStart, TunnelEnd, fadePower);
+    highp float vig = smoothstep(1.1 - edge, 1.05 - edge * 0.5, dist);
+    color.rgb = mix(color.rgb, vec3(0.0, 0.0, 0.0), vig);
+
+    COLOR = color;
+}
