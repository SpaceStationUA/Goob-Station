+		} else {
+			levelCtx.globalAlpha = 0.7;
+		}
+		levelCtx.drawImage(targetCanvas, PosX(targets[i].x) - targetMargin * 0.5, PosY(targets[i].y) - targetMargin * 0.5);
+	}
+
+	levelCtx.globalAlpha = 1;
+
+	//Gate image
