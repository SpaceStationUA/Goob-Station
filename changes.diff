index 0000000000..2f6b6fe7ab
--- /dev/null
+++ b/Resources/Locale/uk-UA/prototypes/entities/mobs/npcs/animals.ftl
@@ -0,0 +1,123 @@
+ent-MobAngryBee = бджола
+    .desc = Яка гарна бджілка. О ні, вона виглядає сердитою і хоче мою піцу.
+ent-MobBaseAncestor = генетичний предок
+    .desc = Генетичний двоногий предок... Е-е... чогось. Так, на станції точно є щось, що походить від того, що б це не було.
+ent-MobBaseKobold = кобольд
+    .desc = Кузени розумної раси людей-ящірок, кобольди зливаються зі своїм природним середовищем існування і є такими ж огидними, як і мавпи; вони готові вирвати вам волосся і зарізати.
+ent-MobBaseSyndicateMonkey = мавпа
+    .desc = Нова церква неодарвіністів насправді вірить, що КОЖНА тварина походить від мавпи. На смак вони схожі на свинину, а вбивати їх одночасно весело і розслабляюче.
+ent-MobBat = летюча миша
+    .desc = Деякі культури вважають їх жахливими, інші - хрусткими на зубах.
+ent-MobBee = бджола
+    .desc = Приємно мати, але на одному меді цивілізацію не побудуєш.
+ent-MobBoxingKangaroo = кенгуру-боксер
+    .desc = { ent-MobKangaroo.desc }
+ent-MobButterfly = метелик
+    .desc = Всупереч поширеному стереотипу, насправді в головах вони не бувають.
+ent-MobCat = кішка
+    .desc = Котячий улюбленець, дуже кумедний.
+ent-MobCatCalico = кішка каліко
+    .desc = Котячий улюбленець, дуже кумедний.
+ent-MobCatCaracal = каракал
+    .desc = Смішно.
+ent-MobCatKitten = кошеня
+    .desc = Маленьке і пухнасте.
+ent-MobCatSpace = космічний кіт
+    .desc = Котячий улюбленець, підготовлений до найгіршого.
+ent-MobChicken = курка
+    .desc = З'явився раніше яйця і є динозавром!
+ent-MobClownSpider = павук-клоун
+    .desc = Поєднує в собі дві найстрашніші речі в світі - павуків і клоунів.
+ent-MobCockroach = тарган
+    .desc = Ця станція просто кишить жуками.
+ent-MobCorgi = коргі
+    .desc = Нарешті, космічний коргі!
+ent-MobCorgiBase = коргі
+    .desc = Нарешті, космічний коргі!
+ent-MobCorgiNarsi = зіпсований коргі
+    .desc = Іане! Ні!
+ent-MobCorgiPuppy = цуценя коргі
+    .desc = Маленький коргі! Ох...
+ent-MobCorgiSmart = розумний коргі
+    .desc = Незвично розумний собака.
+ent-MobCow = корова
+    .desc = Муу. Більше прав коровам...
+ent-MobCrab = краб
+    .desc = Існує народна легенда, що він вириває кігтями космонавтів за неприємні зауваження. Будьте ввічливі та толерантні заради власної безпеки.
+ent-MobDionaNymph = німфа діони
