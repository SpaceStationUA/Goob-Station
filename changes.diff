diff --git a/Content.Client/_Pirate/Administration/MentorHelp/MentorHelpControl.xaml.cs b/Content.Client/_Pirate/Administration/MentorHelp/MentorHelpControl.xaml.cs
new file mode 100644
index 0000000000..8c8a5080fa
