objective-issuer-hitman = [color=#746694]Злочинець[/color]

hitman-role-greeting-human =
    Ви найманий убивця, якого найняли для ліквідації цілі.
    Для цього вбивства є додаткові умови.
    Намагайтеся не зачепити сторонніх.
hitman-briefing =
    Ви підготували кейс для виконання контракту.
    Ви взяли його із собою на цю зміну.
hitman-round-end-name = Найманий убивця
hitman-round-end-agent-name = Найманий убивця
ghost-role-information-hitman-name = Найманий убивця
ghost-role-information-hitman-description = Контрактний убивця, якого найняли ліквідувати конкретну особу.
ghost-role-information-hitman-rules = Ви [color=red][bold]одноосібний антагоніст[/bold][/color].
    Ви можете вбити свою ціль, але не зобов'язані стежити, щоб вона залишалася мертвою.
    Не нападайте на інших без потреби, крім самозахисту або гарантії смерті цілі.

hitman-sharpshooter-kit-name = Набір снайпера
hitman-sharpshooter-kit-description = Набір для тих, хто воліє вбивати здалеку. Містить гвинтівку з боєприпасами, тепловізор, бінокль, коробку для непомітності та цигарки.
hitman-bounty-hunter-kit-name = Набір мисливця за головами
hitman-bounty-hunter-kit-description = Набір для прямого підходу: важільна гвинтівка й Пітон із бронебійними набоями, додатковий швидкозарядник, ковбойський одяг та селектор костюма для космічних операцій.
hitman-assassin-kit-name = Набір асасина
hitman-assassin-kit-description = Набір для непомітного проникнення: Cobra з отруйними й транквілізаторними магазинами, хамелеон-одяг, агентська ID-картка, фальшивий щит розуму та імплант маскування голосу.
hitman-ninja-kit-name = Набір ніндзя
hitman-ninja-kit-description = Набір для ближнього бою: середньочастотна катана, метальні ножі, імплант втечі, неслизьке взуття, димові гранати, стимулятори та бойова аптечка.
hitman-poisoner-kit-name = Набір отруйника
hitman-poisoner-kit-description = Набір для поціновувачів хімії: просунутий інжектор і пляшки Pax, токсину, німого токсину та ноктурину, а також комплект хімічного синтезу.
hitman-saboteur-kit-name = Набір диверсанта
hitman-saboteur-kit-description = Набір для доступу всюди: криптографічний секвенсор, відмичка повітряних шлюзів, інструменти, RCD із матеріалом і сигналізатор смертника для пасток.
hitman-tracker-kit-name = Набір стеження
hitman-tracker-kit-description = Набір для тих, хто хоче знати все: ключі зв'язку, шпигунський монітор, жучок камер, детектор ШІ під виглядом мультитула, замасковані окуляри та портативна карта станції.

ent-HitmanCase = кейс найманого убивці
    .desc = Кейс із професійними інструментами найманого убивці.
ent-HitmanBusinessCard = візитівка найманого убивці
    .desc = Чорна картка з прицілом. На звороті щось написано.
ent-ActionCreateHitmanCard = Створити візитівку
    .desc = Створює візитівку, на якій можна писати.
ent-HitmanCardImplanter = імплантер візитівки
ent-HitmanCardImplant = імплант візитівки
    .desc = Дозволяє користувачеві створювати візитівки за бажанням.
ent-HitmanIDCard = ID-картка найманого убивці
ent-HitmanPDA = КПК найманого убивці
ent-ClothingUniformHitmanSuit = костюм контрактного убивці
    .desc = Ідеальне вбрання для маскування на заході, в офісі чи на космічній станції.
ent-WeaponMFKatana = середньочастотна катана
    .desc = Надзвичайно гостра катана з нагрітим лезом, здатна різати плоть і сталь.
ent-WeaponLeverActionSKL93 = SKL93
    .desc = Сучасна легка важільна гвинтівка з великим магазином і прицілом. Використовує набої .45 Magnum.
ent-WeaponLeverActionSKL93AP = { ent-WeaponLeverActionSKL93 }
    .desc = { ent-WeaponLeverActionSKL93.desc }
ent-ClothingNeckCWPGorlex = пончо Gorlex для холодної погоди
    .desc = Стильне червоно-чорне пончо з важкої куленепробивної тканини.
ent-MagazinePistolCaselessRiflePoison = магазин пістолета (.25 безгільзовий токсин)
    .desc = Десятизарядний магазин для пістолета Cobra з отруйними набоями.
ent-MagazinePistolCaselessRifleTranquilizer = магазин пістолета (.25 безгільзовий транквілізатор)
    .desc = Десятизарядний магазин для пістолета Cobra із транквілізаторними набоями.
ent-CartridgeCaselessRiflePoison = набій (.25 безгільзовий токсин)
    .desc = Малокаліберний безгільзовий набій з отруйним зарядом.
ent-CartridgeCaselessRifleTranquilizer = набій (.25 безгільзовий транквілізатор)
    .desc = Малокаліберний безгільзовий набій із сумішшю для тихого знешкодження.
ent-BulletCaselessRiflePoison = куля (.25 безгільзовий токсин)
ent-BulletCaselessRifleTranquilizer = куля (.25 безгільзовий транквілізатор)
ent-ClothingMaskOniBlue = синя маска оні
    .desc = Маска, що зображає люту істоту з японських міфів.
ent-Doorjack = відмичка повітряних шлюзів
    .desc = Спеціальний криптографічний секвенсор для обходу кодів доступу повітряних шлюзів.
ent-DeadMansSignaler = сигналізатор смертника
    .desc = Увімкнений пристрій надсилає сигнал навколишнім пристроям, коли його впустити або прибрати.
ent-SpyCrewMonitor = шпигунський монітор
    .desc = Пристрій для підключення до серверів моніторингу екіпажу.
ent-HandheldStationMapRecordsTablet = планшет карти станції
    .desc = Показує карту поточної станції.
ent-EncryptionKeyTraffic = ключ зв'язку диспетчерської
    .desc = Ключ шифрування каналу космічного руху.
ent-MindRoleHitman = Роль найманого убивці
chat-radio-traffic = Диспетчерська

ent-HitmanTeachLessonRandomPersonObjective = Провчити ціль
    .desc = Клієнт хоче смерті цієї особи. Убийте її один раз, щоб виконати контракт.
ent-HitmanTeachLessonRandomHeadObjective = Провчити керівника
    .desc = { ent-HitmanTeachLessonRandomPersonObjective.desc }
ent-HitmanEscapeShuttleObjective = Втекти живим
    .desc = Ви підготували шлях відступу до ЦентКома. Не дозвольте себе заарештувати.
ent-HitmanSurviveObjective = Пережити зміну
    .desc = Клієнт виплатить решту в іншому місці. Не помирайте до цього моменту.
ent-HitmanNiceObjective = Убити чемно
    .desc = Клієнт хоче, щоб ви були шанобливими до цілі навіть під час убивства.
ent-HitmanDramaticObjective = Убити драматично
    .desc = Клієнт хоче перетворити смерть на виставу. Влаштуйте гідне видовище.
ent-HitmanHumorousObjective = Убити смішно
    .desc = Клієнт хоче перетворити смерть на жарт. Зробіть її кумедною.
ent-HitmanAccidentObjective = Замаскувати смерть під нещасний випадок
    .desc = Клієнт не хоче, щоб смерть виглядала як замовне вбивство. Обставте все як нещасний випадок.
ent-HitmanIndirectlyObjective = Убити опосередковано
    .desc = Клієнт не хоче, щоб вас побачили біля тіла. Убийте ціль не власноруч.
ent-HitmanCleanObjective = Убити чисто
    .desc = Клієнт не хоче безладу. Завдайте якомога менше пошкоджень.
ent-HitmanSufferObjective = Розтягнути вбивство
    .desc = Клієнт хоче, щоб ціль страждала. Не поспішайте із завершенням.
ent-HitmanPublicObjective = Убити публічно
    .desc = Клієнт хоче надіслати повідомлення. Убийте ціль у людному місці на очах свідків.
ent-HitmanNoticeObjective = Попередити про вбивство заздалегідь
    .desc = Клієнт хоче, щоб ціль знала про неминучу смерть задовго до неї.
ent-HitmanTraumaObjective = Убити близьку людину цілі
    .desc = Знайдіть близьку до цілі людину, убийте її один раз і переконайтеся, що ціль про це дізнається.
ent-HitmanTrustObjective = Завоювати довіру цілі
    .desc = Клієнт хоче, щоб ціль відчула зраду. Проводьте з нею багато часу.

paper-hitman-business-card = [color=#FFFFFF]Це просто бізнес[/color]
