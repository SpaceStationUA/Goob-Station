gang-invite-already-outgoing = У тебе вже є активне вихідне запрошення!
gang-invite-target-invalid = Ця особа не може приєднатися до банди!

gang-invite-window-title = Запрошення до банди
gang-invite-window-prompt = {$leader} хоче, щоб ти приєднався до [color=#{$color}]{$gangName}[/color]!
gang-invite-window-timer = Залишилося часу: {$seconds} с
gang-invite-window-accept = Прийняти
gang-invite-window-deny = Відхилити

