modsuit-action-deploy-name = [color=#58c4e8]Deploy MODsuit[/color]
modsuit-action-deploy-desc = Opens the suit, placing all installed parts onto the body.
modsuit-action-retract-name = [color=#58c4e8]Retract MODsuit[/color]
modsuit-action-retract-desc = Folds the suit back into its compact state. The suit must be powered down first.
modsuit-action-activate-name = [color=#58c4e8]Activate MODsuit[/color]
modsuit-action-activate-desc = Seals the suit's parts and powers it up. Press once to arm, then again to confirm.
modsuit-action-deactivate-name = [color=#58c4e8]Deactivate MODsuit[/color]
modsuit-action-deactivate-desc = Powers the suit down and unseals its parts. Press once to arm, then again to confirm.

modsuit-continue-sealing = Sealing the next part...
modsuit-continue-unsealing = Unsealing the next part...
modsuit-magboots-on = The suit's magnetic boots engage.
modsuit-magboots-off = The suit's magnetic boots disengage.
modsuit-retract-blocked-active = Power the suit down first.
