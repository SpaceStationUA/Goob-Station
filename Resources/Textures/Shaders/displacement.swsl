uniform sampler2D displacementMap;
uniform highp float displacementSize;
uniform highp vec4 displacementUV;
// Pirate: keep rectangular sprites centered on the map and clamp sampling to this atlas frame.
uniform highp vec2 displacementMapScale;
uniform highp vec2 displacementMapTexelSize;

varying highp vec2 displacementCoord;

void vertex() {
    displacementCoord = (tCoord2 - vec2(0.5)) * displacementMapScale + vec2(0.5);
}

void fragment() {
    highp vec2 coord = clamp(displacementCoord, displacementMapTexelSize * 0.5, vec2(1.0) - displacementMapTexelSize * 0.5);
    highp vec2 displacementUVOut = mix(displacementUV.xy, displacementUV.zw, coord);
    highp vec4 displacementSample = texture2D(displacementMap, displacementUVOut);
    highp vec2 displacementValue = (displacementSample.xy - vec2(128.0 / 255.0)) / (1.0 - 128.0 / 255.0);
    COLOR = zTexture(UV + displacementValue * TEXTURE_PIXEL_SIZE * displacementSize * vec2(1.0, -1.0));
    COLOR.a *= displacementSample.a;
}


