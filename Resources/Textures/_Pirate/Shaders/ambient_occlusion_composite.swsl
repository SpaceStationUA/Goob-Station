light_mode unshaded;
blend_mode none;

// alpha = coverage of the flat sprites after the upright mobs (the alpha was cleared again there).
uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D FLOOR_TEXTURE;
// alpha = coverage of every caster up to and including the upright mobs.
uniform sampler2D AFTER_MOBS_TEXTURE;
// Linear R8: texture2D avoids the engine's sRGB decode in zTextureSpec.
uniform sampler2D MASK_TEXTURE;
// Maps full-resolution FRAGCOORD to mask UV, including the downsample's odd-size alignment.
uniform highp vec2 MASK_UV_SCALE;
// The silhouettes of stealthed entities (any alpha): they show the floor, so they get the floor's shadow (no
// tell-tale hole).
uniform sampler2D EXCLUDE_TEXTURE;
// The other casters inside a silhouette, drawn again: the frame has no coverage of them there.
uniform sampler2D OTHER_FLAT_TEXTURE;
uniform sampler2D OTHER_UPRIGHT_TEXTURE;
// x = 0, y = how many render pixels up the shadow caster is (the shadow falls down the screen).
uniform highp vec2 SHIFT;
// rgb = shadow colour in sRGB, a = strength.
uniform highp vec4 SHADOW;
uniform bool HAS_EXCLUSIONS;

// a + b over a, the way default blending adds coverage.
highp float over(highp float a, highp float b) {
    return a + b * (1.0 - a);
}

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp vec4 screen = zTextureSpec(SCREEN_TEXTURE, uv);
    highp vec4 floorColour = zTextureSpec(FLOOR_TEXTURE, uv);

    // The real coverage of the frame, and the coverage without the stealthed entities.
    highp float coverage = over(screen.a, zTextureSpec(AFTER_MOBS_TEXTURE, uv).a);
    highp float visibleFloor = 1.0 - coverage;
    if (HAS_EXCLUSIONS && zTextureSpec(EXCLUDE_TEXTURE, uv).a >= 0.5 / 255.0) {
        highp float others = over(zTextureSpec(OTHER_FLAT_TEXTURE, uv).a, zTextureSpec(OTHER_UPRIGHT_TEXTURE, uv).a);
        visibleFloor = 1.0 - others;
    }

    highp float alpha = coverage + floorColour.a * (1.0 - coverage);
    highp vec3 result = screen.rgb;
    // Skip shadow work on opaque pixels. The engine appends its output write after this body,
    // so an early return leaves the pixel undefined.
    if (visibleFloor > 0.0) {
        // FRAGCOORD grows upwards, so the caster of this pixel's shadow sits at +SHIFT.
        highp float shadow = texture2D(MASK_TEXTURE, (FRAGCOORD.xy + SHIFT) * MASK_UV_SCALE).r;
        highp float a = clamp(shadow, 0.0, 1.0) * SHADOW.a;

        // The frame is "sprites over floor" in linear light: replace the floor part with the darkened floor. The
        // floor is already lit, so a floor darker than the shadow colour (an unlit tile, space) must not get brighter.
        highp vec3 floorSrgb = zToSrgb(floorColour).rgb;
        highp vec3 darkSrgb = min(mix(floorSrgb, SHADOW.rgb, a), floorSrgb);
        highp vec3 darkFloor = zFromSrgb(vec4(darkSrgb, 1.0)).rgb;
        result = screen.rgb + (darkFloor - floorColour.rgb) * visibleFloor;
    }

    COLOR = vec4(result, alpha);
}
