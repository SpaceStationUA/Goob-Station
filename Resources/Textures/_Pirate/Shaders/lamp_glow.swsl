// Mask dark pixels so the haze cone does not look like grey fog.
light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float DARK_OPACITY;
uniform highp float DARK_LUMINANCE;
uniform highp float BRIGHT_LUMINANCE;

void fragment() {
    highp vec4 glow = zTexture(UV);
    highp vec3 under = zTextureSpec(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE).rgb;
    highp float luminance = dot(under, vec3(0.2126, 0.7152, 0.0722));
    highp float fade = mix(DARK_OPACITY, 1.0, smoothstep(DARK_LUMINANCE, BRIGHT_LUMINANCE, luminance));
    COLOR = vec4(glow.rgb, glow.a * fade);
}
