// Ported to swsl from "Glitch Effect Shader" by Yui Kinomoto @arlez80:
// https://godotshaders.com/shader/glitch-effect-shader/ (MIT license)
// Modified downstream (Pirate): added a strength uniform (0-1) so the effect
// can be scaled from C# based on the owner's health state, plus slight
// desaturation/flicker touches. Used for the IPC screen vision health glitch.

uniform sampler2D SCREEN_TEXTURE;

uniform highp float strength; // 0.0 = off, 1.0 = full glitch

uniform highp float shake_power = 0.03;
uniform highp float shake_rate = 0.2;
uniform highp float shake_speed = 5.0;
uniform highp float shake_block_size = 30.5;
uniform highp float shake_color_rate = 0.01;

highp float random(highp float seed)
{
    return fract(543.2543 * sin(dot(vec2(seed, seed), vec2(3525.46, -54.3415))));
}

void fragment()
{
    highp float s = clamp(strength, 0.0, 1.0);

    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;

    highp float enable_shift = float(
        random(trunc(TIME * shake_speed)) < shake_rate * s
    );

    highp vec2 fixed_uv = uv;
    fixed_uv.x += (
        random(
            (trunc(uv.y * shake_block_size) / shake_block_size)
        +   TIME
        ) - 0.5
    ) * shake_power * enable_shift * (0.5 + s);

    highp vec4 pixel_color = zTextureSpec(SCREEN_TEXTURE, fixed_uv);
    pixel_color.r = mix(
        pixel_color.r
    ,   zTextureSpec(SCREEN_TEXTURE, fixed_uv + vec2(shake_color_rate, 0.0)).r
    ,   enable_shift
    );
    pixel_color.b = mix(
        pixel_color.b
    ,   zTextureSpec(SCREEN_TEXTURE, fixed_uv + vec2(-shake_color_rate, 0.0)).b
    ,   enable_shift
    );

    // Slight desaturation while glitching, to sell "failing optics".
    highp float luma = dot(pixel_color.rgb, vec3(0.2126, 0.7152, 0.0722));
    pixel_color.rgb = mix(pixel_color.rgb, vec3(luma), 0.25 * enable_shift * s);

    COLOR = mix(zTextureSpec(SCREEN_TEXTURE, uv), pixel_color, clamp(s * 1.5, 0.0, 1.0));
}
