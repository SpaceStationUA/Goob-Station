// CPU visibility checks run in XRayVisionOverlay because this engine lacks upstream's FOV shadow map.
// This shader only forces unshaded drawing; TileAlpha supplies brightness.
light_mode unshaded;

void fragment()
{
    COLOR = zTexture(UV);
}
