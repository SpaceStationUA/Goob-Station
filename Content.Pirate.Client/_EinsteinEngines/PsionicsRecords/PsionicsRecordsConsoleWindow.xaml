<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:records="clr-namespace:Content.Client._Pirate.StationRecords;assembly=Content.Client"
               Title="{Loc 'psionics-records-console-window-title'}"
               MinSize="930 600"
               SetSize="930 600">
    <BoxContainer Orientation="Vertical">
        <!-- Record search bar
             TODO: make this into a control shared with general records -->
        <BoxContainer Margin="5 5 5 10" HorizontalExpand="true" VerticalAlignment="Center">
            <OptionButton Name="FilterType" MinWidth="200" Margin="0 0 10 0"/> <!-- Populated in constructor -->
            <LineEdit Name="FilterText" PlaceHolder="{Loc 'psionics-records-filter-placeholder'}" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <!-- Record listing -->
            <BoxContainer Orientation="Vertical" Margin="5" MinWidth="250" MaxWidth="250">
                <Label Name="RecordListingTitle" Text="{Loc 'psionics-records-console-records-list-title'}" HorizontalExpand="True" Align="Center"/>
                <Label Name="NoRecords" Text="{Loc 'psionics-records-console-no-records'}" HorizontalExpand="True" Align="Center" FontColorOverride="DarkGray"/>
                <ScrollContainer VerticalExpand="True">
                    <ItemList Name="RecordListing"/> <!-- Populated when loading state -->
                </ScrollContainer>
            </BoxContainer>
            <Label Name="RecordUnselected" Text="{Loc 'psionics-records-console-select-record-info'}" HorizontalExpand="True" Align="Center" FontColorOverride="DarkGray"/>
            <!-- Selected record info -->
            <BoxContainer Name="PersonContainer" Orientation="Vertical" Margin="10 8 5 5" HorizontalExpand="True" Visible="False">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 5" SeparationOverride="10">
                    <records:RecordPortraitPanel Name="Portrait" PhotoStyle="Psionics" MinWidth="240" MaxWidth="240"/>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="1" SeparationOverride="6">
                        <Label Name="PersonName" StyleClasses="font-large"/>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <Label Text="{Loc 'crew-monitoring-ui-job-label'}" FontColorOverride="DarkGray"/>
                            <TextureRect Name="PersonJobIcon" TextureScale="2 2" VerticalAlignment="Center"/>
                            <Label Name="PersonJob"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <Label Text="{Loc 'humanoid-profile-editor-species-label'}" FontColorOverride="DarkGray"/>
                            <Label Name="SpeciesValue" ClipText="True" HorizontalExpand="True"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <Label Text="{Loc 'humanoid-profile-editor-nationality-label'}" FontColorOverride="DarkGray"/>
                            <Label Name="NationalityValue" ClipText="True" HorizontalExpand="True"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <Label Text="{Loc 'humanoid-profile-editor-employer-label'}" FontColorOverride="DarkGray"/>
                            <Label Name="EmployerValue" ClipText="True" HorizontalExpand="True"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <Label Text="{Loc 'humanoid-profile-editor-age-label'}" FontColorOverride="DarkGray"/>
                            <Label Name="AgeValue" ClipText="True" HorizontalExpand="True"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" FontColorOverride="DarkGray"/>
                            <Label Name="GenderValue" ClipText="True" HorizontalExpand="True"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                            <BoxContainer Orientation="Horizontal">
                                <Label Name="StatusLabel" Text="{Loc 'psionics-records-console-status'}" FontColorOverride="DarkGray"/>
                                <Label Text=":" FontColorOverride="DarkGray"/>
                                <AnimatedTextureRect Name="PersonStatusTX" Margin="8 0 0 0" VerticalAlignment="Center"/>
                            </BoxContainer>
                            <OptionButton Name="StatusOptionButton" HorizontalExpand="True"/>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
                <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5" />
                <RichTextLabel Name="PsionicsList" Visible="False"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>

