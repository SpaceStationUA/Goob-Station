<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'backrooms-prey-sense-title'}"
               MinSize="360 420">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="4">
        <Label Text="{Loc 'backrooms-prey-sense-hint'}" />
        <LineEdit Name="SearchLineEdit"
                  HorizontalExpand="True"
                  PlaceHolder="{Loc 'backrooms-prey-sense-search'}" />

        <ScrollContainer VerticalExpand="True"
                         HorizontalExpand="True">
            <BoxContainer Name="TargetsList"
                          Access="Public"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="2" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
