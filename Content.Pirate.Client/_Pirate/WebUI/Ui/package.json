{
  "name": "pirate-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:hex": "esbuild tools/check-hex.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-hex.mjs --log-level=warning && node node_modules/.cache/check-hex.mjs",
    "check": "esbuild tools/check-galaxy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-galaxy.mjs --log-level=warning && node node_modules/.cache/check-galaxy.mjs && npm run -s bake:check",
    "gaps": "esbuild tools/gaps.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gaps.mjs --log-level=warning && node node_modules/.cache/gaps.mjs",
    "render": "esbuild tools/render-svg.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/render-svg.mjs --log-level=warning && node node_modules/.cache/render-svg.mjs",
    "bake": "esbuild tools/bake.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bake.mjs --log-level=warning && node node_modules/.cache/bake.mjs",
    "bake:check": "npm run -s bake -- --check",
    "check:dom": "node tools/check-dom.mjs",
    "check:all": "npm run check && npm run check:dom"
  },
  "dependencies": {
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6",
    "vite-plugin-solid": "^2.10.0"
  }
}
