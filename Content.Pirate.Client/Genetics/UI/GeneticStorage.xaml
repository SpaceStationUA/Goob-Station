<BoxContainer xmlns="https://spacestation14.io"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        Orientation="Vertical"
        HorizontalExpand="True"
        VerticalExpand="True">
    <Label Text="{Loc 'genetics-console-disk-heading'}"/>
    <PanelContainer StyleClasses="LowDivider"/>
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <GridContainer Columns="2" Margin="10">
            <Label Text="{Loc 'genetics-console-inserted-disk'}" MinWidth="220" Margin="0 0 10 4"/>
            <Label Name="DiskName" Text="{Loc 'genetics-console-no-disk'}"/>
            <Label Text="{Loc 'genetics-console-loaded-mutation'}" MinWidth="220" Margin="0 0 10 0"/>
            <Label Name="MutationName" Text="{Loc 'genetics-console-disk-empty'}"/>
        </GridContainer>
    </PanelContainer>
    <Label Text="{Loc 'genetics-console-print-heading'}" Margin="0 20 0 0"/>
    <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8"/>
    <BoxContainer Name="PrintButtons" Orientation="Horizontal"/>
</BoxContainer>
