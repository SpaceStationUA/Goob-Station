<genetics:GenePuzzle xmlns="https://spacestation14.io"
        xmlns:genetics="using:Content.Pirate.Client.Genetics.UI">
    <BoxContainer Orientation="Vertical" MinHeight="140">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'genetics-console-genome-sequencer'}" VerticalAlignment="Bottom"/>
            <Control HorizontalExpand="True"/>
            <BoxContainer Name="SequenceButtonContainer" Orientation="Horizontal">
                <Button Name="ResetSequenceButton" Text="{Loc 'genetics-console-reset-sequence'}" MinSize="120 0" Margin="4 0 0 1"/>
                <Button Name="SequenceButton" Text="{Loc 'genetics-console-begin-sequencing'}" StyleClasses="negative" MinSize="120 0" Margin="4 0 0 1"/>
            </BoxContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 10"/>
        <Control HorizontalAlignment="Center">
            <BoxContainer Name="BaseButtons" Orientation="Horizontal"/>
            <Label Name="NoSequence" Text="{Loc 'genetics-console-sequencer-no-sequence-selected'}" StyleClasses="LabelSubText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Control>
        <Label Name="Tip" Text="{Loc 'genetics-console-sequencer-tip'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" Margin="0 6 0 0"/>
    </BoxContainer>
</genetics:GenePuzzle>
