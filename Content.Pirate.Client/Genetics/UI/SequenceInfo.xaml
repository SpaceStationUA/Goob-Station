<BoxContainer xmlns="https://spacestation14.io"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        Orientation="Vertical"
        HorizontalExpand="True"
        VerticalExpand="True"
        Margin="20 0 0 0">
    <Label Text="{Loc 'genetics-console-sequence-info'}"/>
    <PanelContainer StyleClasses="LowDivider"/>
    <PanelContainer VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" ReserveScrollbarSpace="True">
            <BoxContainer Orientation="Vertical" Margin="10">
                <Label Name="NoSequence" Text="{Loc 'genetics-console-sequencer-no-sequence-selected'}" StyleClasses="LabelSubText"/>
                <GridContainer Name="Details" Columns="2" HSeparationOverride="10" VSeparationOverride="4" Visible="False">
                    <Label Text="{Loc 'genetics-console-mutation-name'}" VerticalAlignment="Top"/>
                    <RichTextLabel Name="MutationName" HorizontalExpand="True"/>
                    <Label Text="{Loc 'genetics-console-mutation-desc'}" VerticalAlignment="Top"/>
                    <RichTextLabel Name="MutationDesc" HorizontalExpand="True"/>
                    <Label Text="{Loc 'genetics-console-mutation-instability'}" VerticalAlignment="Top"/>
                    <RichTextLabel Name="MutationInstability" HorizontalExpand="True"/>
                    <Label Text="{Loc 'genetics-console-mutation-rarity'}" VerticalAlignment="Top"/>
                    <RichTextLabel Name="MutationRarity" HorizontalExpand="True"/>
                    <Label Name="CarriersLabel" Text="{Loc 'genetics-scanner-carriers'}" VerticalAlignment="Top" Visible="False"/>
                    <BoxContainer Name="Carriers" Orientation="Vertical" HorizontalExpand="True" Visible="False">
                        <Label Name="CarriersCount" StyleClasses="LabelSubText"/>
                        <OptionButton Name="CarriersSelect" HorizontalExpand="True" Margin="0 2 0 0"/>
                    </BoxContainer>
                </GridContainer>
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</BoxContainer>
