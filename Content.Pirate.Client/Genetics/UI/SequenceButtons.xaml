<BoxContainer xmlns="https://spacestation14.io"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        Orientation="Vertical"
        VerticalExpand="True">
    <Label Text="{Loc 'genetics-console-sequences'}"/>
    <PanelContainer StyleClasses="LowDivider"/>
    <PanelContainer MinWidth="192" VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#202025"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="8" HorizontalAlignment="Center">
            <Label Name="NoSequencesLabel" Text="{Loc 'genetics-console-no-sequences'}" StyleClasses="LabelSubText" Margin="0 10"/>
            <GridContainer Name="Buttons" Columns="2"/>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
