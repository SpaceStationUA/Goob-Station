<BoxContainer xmlns="https://spacestation14.io"
        xmlns:genetics="using:Content.Pirate.Client.Genetics.UI"
        Orientation="Vertical"
        HorizontalExpand="True"
        VerticalExpand="True">
    <genetics:GeneticScanner Name="Scanner"/>
    <BoxContainer Name="MobContainer" Orientation="Vertical" Visible="False">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <genetics:SequenceButtons Name="SequenceButtons"/>
            <genetics:SequenceInfo Name="Info">
                <Button Name="WriteButton" Text="{Loc 'genetics-console-write-mutation'}" Disabled="True" HorizontalExpand="True" Margin="0 8 0 0"/>
                <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
                    <Button Name="PrintScanButton" Text="{Loc 'genetics-console-print-scan'}" Disabled="True" HorizontalExpand="True" Margin="0 0 2 0" Visible="False"/>
                    <Button Name="PrintSequenceButton" Text="{Loc 'genetics-console-print-sequence'}" Disabled="True" HorizontalExpand="True" Margin="2 0 0 0" Visible="False"/>
                </BoxContainer>
            </genetics:SequenceInfo>
        </BoxContainer>
        <genetics:GenePuzzle Name="Puzzle" Margin="0 20 0 0"/>
    </BoxContainer>
</BoxContainer>
