<BoxContainer xmlns="https://spacestation14.io"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        Orientation="Vertical"
        VerticalExpand="True"
        HorizontalExpand="True">
    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <Label Name="ErrorLabel" Text="{Loc 'genetics-console-no-scanner'}" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            <Button Name="ScanButton" Text="{Loc 'genetics-console-scan'}" MinSize="160 0" HorizontalAlignment="Center" Disabled="True"/>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
