<controls:FancyWindow xmlns="https://spacestation14.io"
        xmlns:controls="using:Content.Client.UserInterface.Controls"
        xmlns:genetics="clr-namespace:Content.Pirate.Client.Genetics.UI"
        Title="{Loc 'genetics-scanner-window-title'}"
        MinSize="700 350">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Name="HistoryContainer" Visible="False" Margin="0 0 0 6">
            <Label Text="{Loc 'genetics-scanner-saved-targets'}" Margin="0 0 8 0"/>
            <OptionButton Name="HistoryTarget" HorizontalExpand="True"/>
        </BoxContainer>
        <genetics:GeneticSequencer Name="Sequencer"/>
    </BoxContainer>
</controls:FancyWindow>
