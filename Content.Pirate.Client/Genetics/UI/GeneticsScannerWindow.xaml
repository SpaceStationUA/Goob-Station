<controls:FancyWindow xmlns="https://spacestation14.io"
        xmlns:controls="using:Content.Client.UserInterface.Controls"
        xmlns:genetics="clr-namespace:Content.Pirate.Client.Genetics.UI"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        Title="{Loc 'genetics-scanner-window-title'}"
        MinSize="950 520"
        SetSize="950 545">
    <BoxContainer Orientation="Horizontal" Margin="10">
        <BoxContainer Name="HistoryContainer" Orientation="Vertical" SetWidth="260" Margin="0 0 16 0" Visible="False">
            <Label Text="{Loc 'genetics-scanner-targets'}"/>
            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 4"/>
            <OptionButton Name="SearchMode" Margin="0 0 0 4"/>
            <LineEdit Name="SearchText" PlaceHolder="{Loc 'genetics-scanner-search-placeholder'}" Margin="0 0 0 4"/>
            <Label Name="NoTargets" Text="{Loc 'genetics-scanner-no-targets'}" StyleClasses="LabelSubText" Margin="0 4" Visible="False"/>
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#202025"/>
                </PanelContainer.PanelOverride>
                <ScrollContainer HScrollEnabled="False" ReserveScrollbarSpace="True">
                    <BoxContainer Name="TargetRows" Orientation="Vertical" Margin="4"/>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
        <genetics:GeneticSequencer Name="Sequencer"/>
    </BoxContainer>
</controls:FancyWindow>
